	"keyLayout": 10,
	"keyMappings": [
		"#!no-check",
		"map Y copyWindowInfo type=\"window\" format=\"${url}\"",
		"",
		"# --- Obsidian Reading List Templates ---",
		"# press 'o' then 'm' for a standard Markdown link list",
		"map om copyWindowInfo type=\"window\" format=\"-\\u0020[${title}](${url})\"",
		"# press 'o' then 'c' for Obsidian Info Callouts",
		"map oc copyWindowInfo type=\"window\" format=\">\\u0020[!info]\\u0020${title}\\n>\\u0020Link:\\u0020[Open\\u0020Page](${url})\\n>\\u0020\\n>\\u0020**Quick\\u0020Notes:**\\u0020\\n\"",
		"# press 'o' then 't' for an Obsidian Task Checklist",
		"map ot copyWindowInfo type=\"window\" format=\"-\\u0020[\\u0020]\\u0020[${title}](${url})\\n\\u0020\\u0020\\u0020\\u0020-\\u0020**Key\\u0020Takeaways:**\\u0020\\n\"",
		"# press 'o' then 'b' for Markdown Table Rows",
		"map ob copyWindowInfo type=\"window\" format=\"|\\u0020[${title}](${url})\\u0020|\\u0020\\u0020|\"",
		""
	],
