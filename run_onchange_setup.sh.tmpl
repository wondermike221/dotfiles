{{- if eq .chezmoi.os "darwin" -}}
{{- $isWork := hasSuffix "mhixon" .chezmoi.username -}}
#!/usr/bin/env bash
# Managed by chezmoi — edit .chezmoidata/packages.yaml to change packages.
set -uo pipefail

brew_install() {
    local name="$1" flag="${2:-}"
    local list_flag="--formula"; [[ "$flag" == "--cask" ]] && list_flag="--cask"
    if ! brew list "$list_flag" "$name" &>/dev/null 2>&1; then
        echo "  + $name"
        brew install $flag "$name" || echo "  ! failed: $name"
    fi
}

#── homebrew ──────────────────────────────────────────────────────────────────

if ! command -v brew &>/dev/null; then
    echo "==> installing homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

#── packages ──────────────────────────────────────────────────────────────────

echo "==> brew: managers"
{{ range .brew.managers -}}
brew_install "{{ . }}"
{{ end }}
echo "==> brew: common"
{{ range .brew.common -}}
brew_install "{{ . }}"
{{ end }}
{{ range .brew_cask.common -}}
brew_install "{{ . }}" "--cask"
{{ end }}
{{ if $isWork -}}
echo "==> brew: work"
{{ range .brew.work -}}
brew_install "{{ . }}"
{{ end }}
{{ range .brew_cask.work -}}
brew_install "{{ . }}" "--cask"
{{ end }}
{{- else -}}
echo "==> brew: personal"
{{ range .brew.personal -}}
brew_install "{{ . }}"
{{ end }}
{{ range .brew_cask.personal -}}
brew_install "{{ . }}" "--cask"
{{ end }}
{{- end }}

# cargo — brew's rustup doesn't create ~/.cargo/bin shims, so fall back to rustup which
_cargo=$(command -v cargo 2>/dev/null || rustup which cargo 2>/dev/null || echo "")
cargo_pkgs=(
{{- range .cargo.common }}  "{{ . }}"{{ end }}
{{- range .cargo_darwin.common }}  "{{ . }}"{{ end }}
{{- if $isWork }}
{{- range .cargo.work }}  "{{ . }}"{{ end }}
{{- range .cargo_darwin.work }}  "{{ . }}"{{ end }}
{{- else }}
{{- range .cargo.personal }}  "{{ . }}"{{ end }}
{{- range .cargo_darwin.personal }}  "{{ . }}"{{ end }}
{{- end }}
)
if [[ ${#cargo_pkgs[@]} -gt 0 ]]; then
    if [[ -n "$_cargo" ]]; then
        echo "==> cargo"
        installed=$("$_cargo" install --list 2>/dev/null)
        for p in "${cargo_pkgs[@]}"; do
            if ! echo "$installed" | grep -q "^$p "; then
                echo "  + $p"; "$_cargo" install "$p" || echo "  ! failed: $p"
            fi
        done
    else
        echo "  ! cargo not found — restart shell after rustup install"
    fi
fi

# cargo (git) — git-sourced crates (parallel arrays for bash 3.x compat)
cargo_git_names=(
{{- range .cargo_git.common }}  "{{ .name }}"{{ end }}
{{- if $isWork }}{{ range .cargo_git.work }}  "{{ .name }}"{{ end }}
{{- else }}{{ range .cargo_git.personal }}  "{{ .name }}"{{ end }}{{ end }}
)
cargo_git_urls=(
{{- range .cargo_git.common }}  "{{ .url }}"{{ end }}
{{- if $isWork }}{{ range .cargo_git.work }}  "{{ .url }}"{{ end }}
{{- else }}{{ range .cargo_git.personal }}  "{{ .url }}"{{ end }}{{ end }}
)
if [[ ${#cargo_git_names[@]} -gt 0 ]]; then
    if [[ -n "$_cargo" ]]; then
        echo "==> cargo (git)"
        installed=$("$_cargo" install --list 2>/dev/null)
        for i in "${!cargo_git_names[@]}"; do
            name="${cargo_git_names[$i]}"
            url="${cargo_git_urls[$i]}"
            if ! echo "$installed" | grep -q "^$name "; then
                echo "  + $name"; "$_cargo" install --git "$url" || echo "  ! failed: $name"
            fi
        done
    else
        echo "  ! cargo not found — restart shell after rustup install"
    fi
fi

# mise runtimes
mise_runtimes=(
{{- range .mise.common }}  "{{ . }}"{{ end }}
{{- if $isWork }}{{ range .mise.work }}  "{{ . }}"{{ end }}
{{- else }}{{ range .mise.personal }}  "{{ . }}"{{ end }}{{ end }}
)
if [[ ${#mise_runtimes[@]} -gt 0 ]]; then
    if command -v mise &>/dev/null; then
        echo "==> mise"
        for r in "${mise_runtimes[@]}"; do
            echo "  ~ $r"; mise install "$r" || echo "  ! failed: $r"
        done
    else
        echo "  ! mise not found — install brew managers first"
    fi
fi

#── one-time setup ────────────────────────────────────────────────────────────

echo "==> neovim / lazyvim"
if [[ ! -d "$HOME/.config/nvim" ]]; then
    git clone https://github.com/wondermike221/nvim-config "$HOME/.config/nvim"
fi

echo "==> env vars"
if command -v nvim &>/dev/null && ! grep -q 'EDITOR=nvim' "$HOME/.bashrc" 2>/dev/null; then
    echo 'export EDITOR=nvim' >> "$HOME/.bashrc"
    echo "  EDITOR=nvim → ~/.bashrc"
fi
{{- end -}}
